<Window x:Class="WordFlash.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word-flash settings"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Width" Value="56" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="16">
    <CheckBox x:Name="EnabledBox" Content="Flash verses" FontWeight="SemiBold" Margin="0,0,0,12" />

    <GroupBox Header="Verses">
      <StackPanel>
        <CheckBox x:Name="JesusWordsBox" Content="Words of Jesus (Gospels)" />
        <CheckBox x:Name="ProverbsBox" Content="Proverbs" />
        <CheckBox x:Name="PsalmsBox" Content="Psalms" />
        <CheckBox x:Name="TorahBox" Content="Torah (Genesis – Deuteronomy)" />
        <CheckBox x:Name="ProphetsBox" Content="Prophets (Isaiah – Malachi)" />
        <CheckBox x:Name="PaulsEpistlesBox" Content="Paul's Epistles (Romans – Hebrews)" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Timing">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Reading speed" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,8">
          <ComboBox x:Name="ReadingSpeedBox" Width="180" />
          <TextBlock Text="longer verses stay longer" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Wait between verses" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <TextBox x:Name="GapMinBox" />
          <TextBlock Text="to" VerticalAlignment="Center" />
          <TextBox x:Name="GapMaxBox" />
          <TextBlock Text="minutes (1 – 240)" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Header="Text">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="Font" Width="40" VerticalAlignment="Center" />
          <ComboBox x:Name="FontBox" IsEditable="False" />
        </DockPanel>
        <DockPanel>
          <TextBlock Text="Size" Width="40" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Width="32" TextAlignment="Right" VerticalAlignment="Center"
                     Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}" />
          <Slider x:Name="SizeSlider" Minimum="12" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </GroupBox>

    <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,0,0,16" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" Width="84" IsDefault="True" Click="OnSaveClick" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="84" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
