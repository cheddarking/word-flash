<Application x:Class="WordFlash.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <tb:TaskbarIcon x:Key="TrayIcon"
                    ToolTipText="Word-flash"
                    MenuActivation="LeftOrRightClick"
                    NoLeftClickDelay="True">
      <tb:TaskbarIcon.IconSource>
        <tb:GeneratedIconSource Text="✝"
                                FontSize="28"
                                Foreground="White"
                                Background="#2B4A6F" />
      </tb:TaskbarIcon.IconSource>
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Flashing" IsCheckable="True" Click="OnFlashingClick" />
          <MenuItem Header="Flash now" Click="OnFlashNowClick" />
          <Separator />
          <MenuItem Header="Settings…" Click="OnSettingsClick" />
          <MenuItem Header="Exit" Click="OnExitClick" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
  </Application.Resources>
</Application>
